# Copiá este archivo a `.env` y completá los valores.
# `.env` está gitignoreado — nunca se commitea.

# --- SEC EDGAR ---
# No requiere API key, pero la SEC exige User-Agent con contacto real
# (si no, devuelve 403). Poné tu nombre/app y un email al que puedan escribir.
SEC_USER_AGENT=TuApp/0.1 (tu@email.com)

# --- Massive (ex Polygon.io) — datos de precio ---
# Plan free: 5 llamadas/min, 2 años de histórico, velas diarias y de minuto.
# Sacala en https://massive.com (no pide tarjeta).
POLYGON_API_KEY=

# Llamadas por minuto de tu plan. Free = 5. Starter ($29) = ilimitado.
# El cliente usa esto para el throttle; subilo solo si cambiás de plan.
POLYGON_RATE_LIMIT_PER_MIN=5

# --- Dónde vive la data pesada ---
# IMPORTANTE: el código corre en un worktree de git DESCARTABLE. La data no
# está trackeada, así que si vive adentro del worktree se pierde al borrarlo.
# Por eso el default apunta afuera. Cambiá esto si querés otro disco.
SMALLCAPS_DATA_DIR=
